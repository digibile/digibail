{
  "name": "digibile/digibail-php",
  "description": "Modular PHP application foundation for DigiBail",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3 <8.6",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "php tests/smoke.php && php tests/password_verifier.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
