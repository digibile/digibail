APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECTION_TIMEOUT=5

# Required: generate unique random values of at least 32 bytes.
JWT_SECRET=
OTP_PEPPER=
CAPTCHA_PEPPER=
AUTH_CUSTOMER_ROLE=Customer

# Optional until real SMS delivery is configured.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE=
BRAND_NAME=دیجی‌بایل

# Virtual-card secrets: use a fresh base64-encoded 32-byte AES key.
# Keep CARDS_HASH_PEPPER equal to the existing Cards:HashPepper during an audited hash migration.
CARDS_ENCRYPTION_KEY=
CARDS_HASH_PEPPER=
CARDS_BIN=910100
CARDS_VALID_MONTHS=36

# Comma-separated merchant API keys; keep these server-side only.
GATEWAY_MERCHANT_KEYS=
