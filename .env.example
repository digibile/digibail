# Copy to .env on the deployment host. Never commit the real .env file.
POSTGRES_DB=digibail_prod
POSTGRES_USER=digibail_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql://digibail_app:URL_ENCODED_PASSWORD@db:5432/digibail_prod
PORT=1631
HOST=0.0.0.0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OTP_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
CAPTCHA_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
BRAND_NAME=دیجی‌بایل پی
# OTP fails closed unless both provider values are set.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
