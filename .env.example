# Single database: the existing DirectAdmin MariaDB socket.
MARIADB_DATABASE=digibail_vamcitydigibilepay
MARIADB_USER=digibail_vamcitydigibilepay
MARIADB_PASSWORD=REPLACE_WITH_EXISTING_MARIADB_PASSWORD
MARIADB_SOCKET=/tmp/mysql.sock
MARIADB_SOCKET_GID=REPLACE_WITH_SOCKET_GROUP_ID

PORT=1631
HOST=0.0.0.0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OTP_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
CAPTCHA_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
BRAND_NAME=دیجی‌بایل پی

# OTP requires real Kavenegar credentials; blank values keep it fail-closed.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Optional AI providers. Keep real keys only in the server .env.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-20250514
